# Replace every @PLACEHOLDER@ in a private owned copy; nginx -t before launch.
daemon off;
master_process on;
worker_processes 1;
pid @RUNTIME@/nginx.pid;
error_log @RUNTIME@/nginx-error.log warn;
events { worker_connections 128; }
http {
    access_log off;
    client_body_temp_path @RUNTIME@/body;
    proxy_temp_path @RUNTIME@/proxy;
    # Distribution modules initialize their temp paths even when unused here.
    fastcgi_temp_path @RUNTIME@/fastcgi;
    uwsgi_temp_path @RUNTIME@/uwsgi;
    scgi_temp_path @RUNTIME@/scgi;
    client_header_timeout 5s;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 8k;
    client_max_body_size 16k;
    client_body_buffer_size 32k;
    client_body_timeout 5s;
    send_timeout 5s;
    keepalive_timeout 5s;
    keepalive_requests 100;
    open_file_cache off;
    server {
        listen 127.0.0.1:@EDGE_PORT@ backlog=64;
        server_name _;
        if ($http_host != "@AUTHORITY@") { return 421; }
        # Evaluated for each request, including existing keepalive connections.
        # The gate starts absent; create it only after private readiness passes.
        if (!-f @RUNTIME@/business-open) { return 503; }
        location = /health { return 404; }
        location ^~ /health/ { return 404; }
        location = /metrics { return 404; }
        location ^~ /metrics/ { return 404; }
        location / {
            proxy_pass http://127.0.0.1:@APP_PORT@;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Connection "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_connect_timeout 1s;
            proxy_read_timeout 7s;
            proxy_send_timeout 5s;
            proxy_next_upstream off;
            proxy_cache off;
            proxy_request_buffering on;
            proxy_buffering on;
            proxy_buffer_size 8k;
            proxy_buffers 4 8k;
            proxy_busy_buffers_size 16k;
            proxy_max_temp_file_size 0;
        }
    }
}
